model ArtifactSet {
  id          String     @id @default(cuid())
  campaignId  String
  name        String
  description String?
  setBonus    Json?
  icon        String?
  createdAt   DateTime   @default(now())
  abilities   Json       @default("[]")
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]
  sourceId    String?
  sourceHash  String?
  slug        String?

  @@index([campaignId])
  @@index([campaignId, sourceId])
  @@map("artifact_sets")
}

