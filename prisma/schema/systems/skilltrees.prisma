model SkillTreeBase {
  id               String
  race             String
  skills           Json     @default("[]")
  createdAt        DateTime @default(now())
  slug             String?
  sourceCampaignId String
  validFrom        Int
  validTo          Int?

  @@id([id, validFrom])
  @@index([sourceCampaignId, validFrom, validTo])
  @@index([sourceCampaignId, slug])
  @@map("skill_trees_base")
}

