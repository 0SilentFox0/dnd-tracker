model SkillTree {
  id              String            @id @default(cuid())
  campaignId      String
  race            String
  skills          Json              @default("[]")
  createdAt       DateTime          @default(now())
  characterSkills CharacterSkills[]
  sourceId        String?
  sourceHash      String?
  slug            String?

  @@index([campaignId, race])
  @@index([campaignId, sourceId])
  @@map("skill_trees")
}

model CharacterSkills {
  id             String    @id @default(cuid())
  characterId    String
  skillTreeId    String
  unlockedSkills Json      @default("[]")
  updatedAt      DateTime  @updatedAt
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillTree      SkillTree @relation(fields: [skillTreeId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillTreeId])
  @@index([skillTreeId])
  @@map("character_skills")
}

// No Prisma relation to Character (core model); the FK lives in the migration only.
model SkillTreeProgress {
  characterId String   @id @map("character_id")
  progress    Json     @default("{}")
  version     Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("skill_tree_progress")
}

// BEGIN GENERATED BASE MODELS (scripts/db/gen-base-models.ts)

model SkillTreeBase {
  id               String
  race             String
  skills           Json     @default("[]")
  createdAt        DateTime @default(now())
  slug             String?
  sourceCampaignId String
  validFrom        Int
  validTo          Int?

  @@id([id, validFrom])
  @@index([sourceCampaignId, validFrom, validTo])
  @@index([sourceCampaignId, slug])
  @@map("skill_trees_base")
}

