generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id
  email               String               @unique
  displayName         String
  avatar              String?
  locale              String?
  createdAt           DateTime             @default(now())
  campaignMembers     CampaignMember[]
  dmCampaigns         Campaign[]           @relation("DMCampaigns")
  characters          Character[]
  aiCredentials       AiCredential[]
  onboardingFlags     UserOnboardingFlag[]
  worldNotes          WorldNote[]
  worldTravelLog      WorldTravelLog[]
  playerNotifications PlayerNotification[]
  acquaintanceNotes   AcquaintanceNote[]

  @@map("users")
}

model Campaign {
  id                   String                @id @default(cuid())
  sourceSync           CampaignSourceSync?
  name                 String
  description          String?
  inviteCode           String                @unique
  dmUserId             String
  maxLevel             Int                   @default(20)
  xpMultiplier         Float                 @default(2.5)
  allowPlayerEdit      Boolean               @default(true)
  critChoiceByDm       Boolean               @default(false)
  acquaintancesEnabled Boolean               @default(false)
  status               String                @default("active")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  friendlyFire         Boolean               @default(false)
  rules                Json                  @default("{}")
  kind                 String                @default("campaign")
  visibility           String                @default("private")
  createdFromId        String?
  aiInstructions       String?
  credits              String?
  artifactSets         ArtifactSet[]
  artifacts            Artifact[]
  battles              BattleScene[]
  members              CampaignMember[]
  dm                   User                  @relation("DMCampaigns", fields: [dmUserId], references: [id])
  characters           Character[]
  mainSkills           MainSkill[]
  races                Race[]
  classes              GameClass[]
  backgrounds          Background[]
  feats                Feat[]
  scenarioPages        ScenarioPage[]
  skillTrees           SkillTree[]
  skills               Skill[]
  spellGroups          SpellGroup[]
  spells               Spell[]
  tracks               CampaignTrack[]
  slideDecks           SlideDeck[]
  show                 CampaignShow?
  units                Unit[]
  assistantIntents     AssistantIntent[]
  aiThreads            AiThread[]
  aiProposals          AiProposal[]
  apiTokens            ApiToken[]
  compendiumSources    CompendiumSource[]
  compendiumEntries    CompendiumEntry[]
  compendiumRuns       CompendiumImportRun[]
  inventoryLog         InventoryLog[]
  characterLog         CharacterLog[]
  worldMaps            WorldMap[]
  worldPositions       WorldPosition[]
  worldTravelLog       WorldTravelLog[]
  playerNotifications  PlayerNotification[]
  acquaintances        Acquaintance[]

  @@index([dmUserId])
  @@index([kind, visibility])
  @@map("campaigns")
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  role       String
  joinedAt   DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

model Character {
  id                  String              @id @default(cuid())
  campaignId          String
  type                String
  controlledBy        String
  name                String
  level               Int                 @default(1)
  class               String
  subclass            String?
  race                String
  subrace             String?
  alignment           String?
  background          String?
  notes               String?
  experience          Int                 @default(0)
  avatar              String?
  strength            Int                 @default(10)
  dexterity           Int                 @default(10)
  constitution        Int                 @default(10)
  intelligence        Int                 @default(10)
  wisdom              Int                 @default(10)
  charisma            Int                 @default(10)
  armorClass          Int                 @default(10)
  initiative          Int                 @default(0)
  speed               Int                 @default(30)
  savingThrows        Json                @default("{}")
  skills              Json                @default("{}")
  spellcastingAbility String?
  spellSlots          Json                @default("{}")
  knownSpells         Json                @default("[]")
  languages           Json                @default("[]")
  proficiencies       Json                @default("{}")
  skillTreeProgress   Json                @default("{}")
  seenLevel           Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  immunities          Json                @default("[]")
  morale              Int                 @default(0)
  maxTargets          Int                 @default(1)
  minTargets          Int                 @default(1)
  personalSkillId     String?
  primaryAbility      String?
  goals               Json                @default("[]")
  classes             Json                @default("[]")
  feats               Json                @default("[]")
  backgroundId        String?
  backgroundChoices   Json                @default("{}")
  backgroundFeatPicks Json                @default("{}")
  selectedBackground  Background?         @relation(fields: [backgroundId], references: [id], onDelete: Restrict)
  raceChoices         Json                @default("{}")
  resources           Json                @default("{}")
  inspiration         Boolean             @default(false)
  hpMultiplier        Float?
  archetype           String?
  meleeMultiplier     Float?
  rangedMultiplier    Float?
  status              String              @default("active")
  reviewNote          String?
  inventoryLog        InventoryLog[]
  characterLog        CharacterLog[]
  inventory           CharacterInventory?
  characterSkills     CharacterSkills[]
  scenarioPages       ScenarioPage[]
  tokens              CharacterToken[]
  campaign            Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [controlledBy], references: [id], onDelete: SetNull)
  worldPosition       WorldPosition?
  worldReveals        WorldReveal[]
  worldNotes          WorldNote[]
  acquaintances       Acquaintance[]

  @@index([backgroundId])
  @@index([campaignId])
  @@index([controlledBy])
  @@map("characters")
}

model Unit {
  id                   String   @id @default(cuid())
  campaignId           String
  name                 String
  raceId               String?
  level                Int      @default(1)
  strength             Int      @default(10)
  dexterity            Int      @default(10)
  constitution         Int      @default(10)
  intelligence         Int      @default(10)
  wisdom               Int      @default(10)
  charisma             Int      @default(10)
  armorClass           Int      @default(10)
  initiative           Int      @default(0)
  speed                Int      @default(30)
  gridSize             Int      @default(1)
  maxHp                Int      @default(10)
  proficiencyBonus     Int      @default(2)
  attacks              Json     @default("[]")
  knownSpells          Json     @default("[]")
  avatar               String?
  createdAt            DateTime @default(now())
  immunities           Json     @default("[]")
  morale               Int      @default(0)
  maxTargets           Int      @default(1)
  minTargets           Int      @default(1)
  abilities            Json     @default("[]")
  levelScaling         Json?
  cr                   Float?
  xp                   Int?
  multiattack          Int      @default(1)
  legendaryActions     Int      @default(0)
  legendaryResistances Int      @default(0)
  saveProficiencies    Json     @default("[]")
  statblock            Json     @default("{}")
  spellcasting         Json     @default("{}")
  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  race                 Race?    @relation(fields: [raceId], references: [id], onDelete: SetNull)
  spellsSummoning      Spell[]  @relation("SpellSummonUnit")
  sourceId             String?
  sourceHash           String?

  @@index([campaignId])
  @@index([raceId])
  @@map("units")
}

model Spell {
  id                    String      @id @default(cuid())
  campaignId            String
  name                  String
  executionMode         String      @default("native")
  level                 Int         @default(0)
  type                  String
  damageType            String
  castingTime           String?
  range                 String?
  components            String?
  duration              String?
  concentration         Boolean     @default(false)
  savingThrow           Json?
  hitCheck              Json? // spell attack: { ability, dc } — заклинання застосовується якщо (кидок + мод. кастера) >= dc
  description           String?
  effects               Json? // array of effect strings (like skills)
  effectDetails         Json? // { duration, effects: [{ type, value, isPercentage? }] } from test assertions
  groupId               String?
  createdAt             DateTime    @default(now())
  damageElement         String?
  icon                  String?
  target                String?
  damageModifier        String?
  healModifier          String?
  diceCount             Int?
  diceType              String?
  appearanceDescription String? // опис вигляду для довідника гравців (редагує DM)
  fx                    Json?
  damageDistribution    Json? // [100, 75, 50, 25] — % шкоди на кожну ціль для AoE спелів. Default: усі цілі 100%.
  dice                  Int         @default(0)
  cost                  String      @default("action")
  casting               Json?
  targeting             Json        @default("{\"kind\":\"enemy\"}")
  resolution            Json        @default("{\"kind\":\"auto\"}")
  spellEffects          Json        @default("[]")
  raceModifiers         Json        @default("[]")
  stackable             Boolean     @default(false)
  maxStacks             Int?
  dieSides              Int?
  upcastDice            Int?
  upcastTargets         Int?
  addAbilityMod         Boolean?
  fixedDice             Boolean?
  damageBonus           Int?
  lists                 Json        @default("[]")
  ingredients           Json        @default("[]")
  componentFlags        Json?
  summonUnitId          String?
  summonUnit            Unit?       @relation("SpellSummonUnit", fields: [summonUnitId], references: [id], onDelete: SetNull)
  skills                Skill[]
  skillsAsNewSpell      Skill[]     @relation("SkillNewSpell")
  skillsGrantingSpell   Skill[]     @relation("SkillGrantedSpell")
  campaign              Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spellGroup            SpellGroup? @relation(fields: [groupId], references: [id])
  sourceId              String?
  sourceHash            String?

  @@index([campaignId])
  @@index([groupId])
  @@index([summonUnitId])
  @@map("spells")
}

model SpellGroup {
  id         String      @id @default(cuid())
  campaignId String
  name       String
  color      String?
  icon       String?
  createdAt  DateTime    @default(now())
  skills     Skill[]
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spells     Spell[]
  mainSkills MainSkill[]
  sourceId   String?
  sourceHash String?

  @@index([campaignId])
  @@map("spell_groups")
}

model Artifact {
  id          String       @id @default(cuid())
  campaignId  String
  name        String
  description String?
  rarity      String?
  slot        String
  bonuses     Json         @default("{}")
  modifiers   Json         @default("[]")
  setId       String?
  icon        String?
  createdAt   DateTime     @default(now())
  abilities   Json         @default("[]")
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  artifactSet ArtifactSet? @relation(fields: [setId], references: [id])
  sourceId    String?
  sourceHash  String?

  @@index([campaignId])
  @@index([setId])
  @@map("artifacts")
}

model ArtifactSet {
  id          String     @id @default(cuid())
  campaignId  String
  name        String
  description String?
  setBonus    Json?
  icon        String?
  createdAt   DateTime   @default(now())
  abilities   Json       @default("[]")
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]
  sourceId    String?
  sourceHash  String?

  @@index([campaignId])
  @@map("artifact_sets")
}

model CharacterInventory {
  id          String    @id @default(cuid())
  characterId String    @unique
  equipped    Json      @default("{}")
  backpack    Json      @default("[]")
  gold        Int       @default(0)
  silver      Int       @default(0)
  copper      Int       @default(0)
  items       Json      @default("[]")
  stash       Json      @default("[]")
  attuned     Json      @default("[]")
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_inventories")
}

model InventoryLog {
  id          String    @id @default(cuid())
  campaignId  String
  characterId String
  actorUserId String
  kind        String
  delta       Json      @default("{}")
  note        String?
  createdAt   DateTime  @default(now())
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt(sort: Desc)])
  @@index([campaignId])
  @@map("inventory_log")
}

model CharacterLog {
  id          String    @id @default(cuid())
  campaignId  String
  characterId String
  actorUserId String?
  kind        String
  data        Json      @default("{}")
  createdAt   DateTime  @default(now())
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt(sort: Desc)])
  @@index([campaignId])
  @@map("character_logs")
}

model SkillTree {
  id              String            @id @default(cuid())
  campaignId      String
  race            String
  skills          Json              @default("[]")
  createdAt       DateTime          @default(now())
  characterSkills CharacterSkills[]
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceId        String?
  sourceHash      String?

  @@index([campaignId, race])
  @@map("skill_trees")
}

model CharacterSkills {
  id             String    @id @default(cuid())
  characterId    String
  skillTreeId    String
  unlockedSkills Json      @default("[]")
  updatedAt      DateTime  @updatedAt
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillTree      SkillTree @relation(fields: [skillTreeId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillTreeId])
  @@map("character_skills")
}

model BattleScene {
  id                 String              @id @default(cuid())
  campaignId         String
  name               String
  description        String?
  status             String              @default("prepared")
  participants       Json                @default("[]")
  currentRound       Int                 @default(1)
  currentTurnIndex   Int                 @default(0)
  pendingMoraleCheck Json?
  pendingCritChoice  Json?
  map                Json?
  audio              Json?
  rules              Json?
  createdAt          DateTime            @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  version            Int                 @default(0)
  eventSeq           Int                 @default(0)
  battleParticipants BattleParticipant[]
  battleEvents       BattleEvent[]
  battleSnapshots    BattleSnapshot[]
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("battle_scenes")
}

model CampaignTrack {
  id          String   @id @default(cuid())
  campaignId  String
  title       String
  kind        String
  url         String?
  youtubeId   String?
  durationSec Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceId    String?
  sourceHash  String?

  @@index([campaignId, sortOrder])
  @@map("campaign_tracks")
}

model SlideDeck {
  id             String        @id @default(cuid())
  campaignId     String
  title          String
  sortOrder      Int           @default(0)
  slides         Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scenarioPageId String?
  scenarioPage   ScenarioPage? @relation(fields: [scenarioPageId], references: [id], onDelete: SetNull)

  @@index([scenarioPageId])
  @@index([campaignId, sortOrder])
  @@map("slide_decks")
}

model CampaignShow {
  campaignId   String   @id
  deckId       String?
  deckTitle    String?
  slide        Json?
  nextImageUrl String?
  audio        Json?
  battle       Json?
  cover        Json?
  curtain      Boolean  @default(false)
  world        Json?
  seq          Int      @default(0)
  updatedAt    DateTime @updatedAt
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_shows")
}

model BattleParticipant {
  id                 String      @id
  battleId           String
  sourceType         String
  sourceId           String
  side               String
  controlledBy       String
  orderIndex         Int
  isPending          Boolean     @default(false)
  extraTurnOf        String?
  currentHp          Int
  tempHp             Int
  maxHp              Int
  morale             Int
  status             String
  initiative         Int
  hasUsedAction      Boolean
  hasUsedBonusAction Boolean
  hasUsedReaction    Boolean
  hasExtraTurn       Boolean
  snapshot           Json
  state              Json
  snapshotHash       String
  battle             BattleScene @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@index([battleId, orderIndex])
  @@map("battle_participants")
}

model BattleEvent {
  id          String      @id @default(cuid())
  battleId    String
  seq         Int
  round       Int
  type        String
  actorId     String?
  targets     Json        @default("[]")
  details     Json        @default("{}")
  hpChanges   Json        @default("[]")
  resultText  String
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())
  battle      BattleScene @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, seq])
  @@map("battle_events")
}

model BattleSnapshot {
  battleId String
  seq      Int
  state    Json
  battle   BattleScene @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@id([battleId, seq])
  @@map("battle_snapshots")
}

model StatusEffect {
  id          String  @id @default(cuid())
  name        String
  type        String
  condition   String?
  description String
  effects     Json    @default("[]")
  icon        String?
  color       String?

  @@map("status_effects")
}

model Skill {
  id                      String      @id @default(cuid())
  campaignId              String
  name                    String      @default("")
  description             String?
  spellId                 String?
  spellGroupId            String?
  createdAt               DateTime    @default(now())
  icon                    String?
  image                   String?
  mainSkillId             String?
  spellEnhancementTypes   Json        @default("[]")
  spellEffectIncrease     Int?
  spellTargetChange       Json?
  spellAdditionalModifier Json?
  spellNewSpellId         String?
  grantedSpellId          String? // скіл додає це заклинання персонажу
  spellEnhancementData    Json        @default("{}")
  appearanceDescription   String? // опис вигляду для довідника гравців (редагує DM)
  abilities               Json        @default("[]")
  campaign                Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mainSkill               MainSkill?  @relation(fields: [mainSkillId], references: [id])
  spellGroup              SpellGroup? @relation(fields: [spellGroupId], references: [id])
  spell                   Spell?      @relation(fields: [spellId], references: [id])
  spellNewSpell           Spell?      @relation("SkillNewSpell", fields: [spellNewSpellId], references: [id])
  grantedSpell            Spell?      @relation("SkillGrantedSpell", fields: [grantedSpellId], references: [id])
  sourceId                String?
  sourceHash              String?

  @@index([campaignId])
  @@index([campaignId, id])
  @@index([mainSkillId])
  @@index([spellGroupId])
  @@index([spellId])
  @@index([grantedSpellId])
  @@index([spellNewSpellId])
  @@map("skills")
}

model Race {
  id                   String   @id @default(cuid())
  campaignId           String
  name                 String
  availableSkills      Json     @default("[]")
  disabledSkills       Json     @default("[]")
  passiveAbility       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  spellSlotProgression Json     @default("[]")
  abilities            Json     @default("[]")
  choices              Json     @default("[]")
  icon                 String?
  color                String?
  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  units                Unit[]
  sourceId             String?
  sourceHash           String?

  @@index([campaignId, name])
  @@map("races")
}

model GameClass {
  id                  String   @id @default(cuid())
  campaignId          String
  name                String
  icon                String?
  color               String?
  hitDie              Int      @default(8)
  savingThrows        Json     @default("[]")
  proficiencies       Json     @default("{}")
  skillChoices        Json     @default("{}")
  caster              String   @default("none")
  spellcastingAbility String?
  features            Json     @default("[]")
  subclassLevel       Int?
  subclasses          Json     @default("[]")
  columns             Json     @default("[]")
  spellList           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  sourceId            String?
  sourceHash          String?
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, name])
  @@map("classes")
}

model Feat {
  id           String   @id @default(cuid())
  campaignId   String
  name         String
  icon         String?
  type         String   @default("general")
  prerequisite Json     @default("{}")
  repeatable   Boolean  @default(false)
  description  String?
  abilities    Json     @default("[]")
  choices      Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sourceId     String?
  sourceHash   String?
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, name])
  @@map("feats")
}

model Background {
  id                 String      @id @default(cuid())
  campaignId         String
  name               String
  icon               String?
  description        String?
  choices            Json        @default("[]")
  skillProficiencies Json        @default("[]")
  toolProficiencies  Json        @default("[]")
  originFeatId       String?
  equipmentText      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  sourceId           String?
  sourceHash         String?
  campaign           Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characters         Character[]

  @@index([campaignId, name])
  @@index([originFeatId])
  @@map("backgrounds")
}

model CompendiumSource {
  id         String   @id @default(cuid())
  campaignId String
  sourceJson String
  metadata   Json     @default("{}")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sourceJson])
  @@map("compendium_sources")
}

model CompendiumEntry {
  id             String   @id @default(cuid())
  campaignId     String
  canonicalKey   String
  kind           String
  localId        String
  locator        Json     @default("[]")
  edition        String
  sourceJson     String
  originalName   String
  attribution    Json     @default("{}")
  inputHash      String
  adapterVersion String
  baseline       Json
  notes          String   @default("")
  issues         Json     @default("[]")
  bindings       Json     @default("{}")
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, canonicalKey])
  @@index([campaignId, kind, localId])
  @@map("compendium_entries")
}

model CompendiumImportRun {
  id             String   @id @default(cuid())
  campaignId     String
  userId         String
  idempotencyKey String
  planHash       String
  report         Json
  createdAt      DateTime @default(now())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, idempotencyKey])
  @@index([campaignId, createdAt])
  @@map("compendium_import_runs")
}

model MainSkill {
  id                  String      @id @default(cuid())
  campaignId          String
  name                String
  color               String
  icon                String?
  isEnableInSkillTree Boolean     @default(false)
  spellGroupId        String?
  role                String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  campaign            Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spellGroup          SpellGroup? @relation(fields: [spellGroupId], references: [id], onDelete: SetNull)
  skills              Skill[]
  sourceId            String?
  sourceHash          String?

  @@index([campaignId])
  @@map("main_skills")
}

model CharacterToken {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  color       String
  label       String
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([characterId])
  @@map("character_tokens")
}

model ScenarioPage {
  id          String                @id @default(cuid())
  campaignId  String
  kind        String
  arc         String?
  title       String
  subtitle    String?
  status      String                @default("draft")
  sortOrder   Int                   @default(0)
  characterId String?
  content     Json                  @default("{\"legend\":[],\"sections\":[]}")
  searchText  String                @default("")
  version     Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  campaign    Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character?            @relation(fields: [characterId], references: [id], onDelete: SetNull)
  versions    ScenarioPageVersion[]
  decks       SlideDeck[]
  aiThreads   AiThread[]
  aiProposals AiProposal[]
  pageIndex   ScenarioPageIndex?

  @@index([campaignId, sortOrder])
  @@index([characterId])
  @@map("scenario_pages")
}

model ScenarioPageIndex {
  pageId     String       @id
  campaignId String
  version    Int
  facts      Json
  updatedAt  DateTime     @default(now())
  page       ScenarioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("scenario_page_index")
}

model ScenarioPageVersion {
  id        String       @id @default(cuid())
  pageId    String
  content   Json
  createdAt DateTime     @default(now())
  createdBy String
  page      ScenarioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("scenario_page_versions")
}

model AiCredential {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  ciphertext   String
  iv           String
  authTag      String
  keyVersion   Int      @default(1)
  last4        String
  defaultModel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("ai_credentials")
}

model AiThread {
  id               String            @id @default(cuid())
  campaignId       String
  userId           String
  mode             String
  scenarioPageId   String?
  executionMode    String            @default("review")
  assistantIntents AssistantIntent[]
  assistantRuns    AssistantRun[]
  title            String
  provider         String
  model            String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scenarioPage     ScenarioPage?     @relation(fields: [scenarioPageId], references: [id], onDelete: SetNull)
  messages         AiMessage[]
  proposals        AiProposal[]

  @@index([campaignId, userId, updatedAt])
  @@map("ai_threads")
}

model AiMessage {
  id        String   @id @default(cuid())
  threadId  String
  seq       Int
  role      String
  parts     Json
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  thread    AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, seq])
  @@map("ai_messages")
}

model AiProposal {
  id             String       @id @default(cuid())
  campaignId     String
  threadId       String?
  pageId         String
  summary        String
  ops            Json
  status         String       @default("pending")
  appliedVersion Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  thread         AiThread?    @relation(fields: [threadId], references: [id], onDelete: SetNull)
  page           ScenarioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, status])
  @@index([campaignId])
  @@index([threadId])
  @@map("ai_proposals")
}

model ApiToken {
  id               String            @id @default(cuid())
  campaignId       String
  userId           String
  executionMode    String            @default("review")
  assistantIntents AssistantIntent[]
  name             String
  tokenHash        String            @unique
  prefix           String
  scopes           String[]
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("api_tokens")
}

model CampaignSourceSync {
  campaignId       String   @id
  sourceCampaignId String
  baseline         Json
  ignored          Json     @default("{}")
  syncedAt         DateTime @default(now())
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_source_syncs")
}

model UserOnboardingFlag {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_onboarding_flags")
}

// Intent content follows campaign lifetime; receipts intentionally do not.
model AssistantIntent {
  id               String    @id @default(cuid())
  campaignId       String
  userId           String
  channel          String
  threadId         String?
  tokenId          String?
  originThreadId   String?
  originTokenId    String?
  originKey        String
  requestId        String
  requestHash      String
  actionId         String
  summary          String
  targets          Json      @default("[]")
  payload          Json
  preview          Json
  expected         Json
  status           String    @default("pending")
  expiresAt        DateTime
  redactedAt       DateTime?
  legacyProposalId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  thread           AiThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  token            ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@unique([userId, originKey, requestId])
  @@index([campaignId, userId, status, createdAt, id])
  @@index([threadId])
  @@index([tokenId])
  @@index([status, updatedAt])
  @@map("assistant_intents")
}

model AssistantReceipt {
  id            String   @id @default(cuid())
  intentId      String   @unique
  campaignId    String
  userId        String
  originTokenId String?
  originKey     String
  requestId     String
  requestHash   String
  actionId      String
  status        String
  result        Json
  effects       Json     @default("[]")
  effectsStatus String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, originKey, requestId])
  @@index([campaignId, userId, createdAt])
  @@index([status, effectsStatus, updatedAt])
  @@map("assistant_receipts")
}

model AssistantRun {
  id             String   @id @default(cuid())
  threadId       String
  requestId      String
  requestHash    String
  activeThreadId String?  @unique
  status         String   @default("running")
  expiresAt      DateTime
  abortRequested Boolean  @default(false)
  resultRefs     Json     @default("[]")
  errorCode      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  thread         AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, requestId])
  @@index([status, expiresAt])
  @@map("assistant_runs")
}

model WorldMap {
  id             String           @id @default(cuid())
  campaignId     String
  parentMarkerId String?          @unique
  name           String
  imageUrl       String
  width          Int
  height         Int
  fogEnabled     Boolean          @default(true)
  revealRadius   Float            @default(0.04)
  entryX         Float            @default(0.5)
  entryY         Float            @default(0.5)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parentMarker   WorldMarker?     @relation("NestedMap", fields: [parentMarkerId], references: [id], onDelete: Cascade)
  markers        WorldMarker[]    @relation("MapMarkers")
  positions      WorldPosition[]
  reveals        WorldReveal[]
  travelLog      WorldTravelLog[]

  @@index([campaignId])
  @@map("world_maps")
}

model WorldMarker {
  id            String           @id @default(cuid())
  mapId         String
  kind          String
  x             Float
  y             Float
  polygon       Json?
  name          String
  icon          String?
  color         String?
  dmNote        String?
  alwaysVisible Boolean          @default(false)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  map           WorldMap         @relation("MapMarkers", fields: [mapId], references: [id], onDelete: Cascade)
  childMap      WorldMap?        @relation("NestedMap")
  notes         WorldNote[]
  arrivals      WorldTravelLog[]

  @@index([mapId, sortOrder])
  @@map("world_markers")
}

model WorldPosition {
  characterId String    @id
  campaignId  String
  mapId       String
  x           Float
  y           Float
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  map         WorldMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("world_positions")
}

model WorldReveal {
  id          String    @id @default(cuid())
  mapId       String
  characterId String
  shape       Json
  createdAt   DateTime  @default(now())
  map         WorldMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([mapId, characterId])
  @@map("world_reveals")
}

model WorldTravelLog {
  id           String       @id @default(cuid())
  campaignId   String
  mapId        String
  characterIds String[]
  from         Json?
  to           Json
  toMarkerId   String?
  rest         String       @default("none")
  kind         String       @default("travel")
  byUserId     String?
  createdAt    DateTime     @default(now())
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  map          WorldMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  toMarker     WorldMarker? @relation(fields: [toMarkerId], references: [id], onDelete: SetNull)
  byUser       User?        @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@map("world_travel_log")
}

model WorldNote {
  id           String      @id @default(cuid())
  markerId     String
  authorUserId String
  characterId  String?
  visibility   String
  text         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  marker       WorldMarker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  character    Character?  @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([markerId])
  @@map("world_notes")
}

model PlayerNotification {
  id         String    @id @default(cuid())
  userId     String
  campaignId String
  type       String
  refId      String
  href       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, type, refId])
  @@index([userId, campaignId, readAt])
  @@index([readAt])
  @@map("player_notifications")
}

model Acquaintance {
  id              String              @id @default(cuid())
  campaignId      String
  kind            String
  characterId     String?
  name            String
  avatarUrl       String?
  description     String              @default("")
  sourcePageId    String
  sourceSectionId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  campaign        Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character       Character?          @relation(fields: [characterId], references: [id], onDelete: SetNull)
  entries         AcquaintanceEntry[]
  notes           AcquaintanceNote[]

  @@index([campaignId, sourcePageId])
  @@index([characterId])
  @@map("acquaintances")
}

model AcquaintanceEntry {
  id             String       @id @default(cuid())
  acquaintanceId String
  pageId         String
  sectionId      String
  text           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  acquaintance   Acquaintance @relation(fields: [acquaintanceId], references: [id], onDelete: Cascade)

  @@index([acquaintanceId])
  @@index([pageId])
  @@map("acquaintance_entries")
}

model AcquaintanceNote {
  id             String       @id @default(cuid())
  acquaintanceId String
  authorUserId   String
  text           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  acquaintance   Acquaintance @relation(fields: [acquaintanceId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([acquaintanceId, authorUserId])
  @@map("acquaintance_notes")
}
