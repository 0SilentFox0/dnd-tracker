{
    "profiles": {
        "en-srd": {
            "locale": "en",
            "db": "landingshots",
            "campaignId": "example-demo-5e",
            "battleId": "demo-battle-grove",
            "scenePageId": "demo-bell-scene",
            "deckId": "demo-deck-listening-grove",
            "heroId": "demo-character-scout",
            "sheetId": "demo-character-rogue",
            "classLink": "Ranger",
            "shots": [
                {
                    "name": "battle",
                    "path": "/battles/{battleId}",
                    "steps": [
                        {
                            "click": "[data-tour='battle.dm-open']"
                        },
                        {
                            "wait": 600
                        },
                        {
                            "click": "div.border-b:has-text('Maelis') >> button[title='Take control']"
                        },
                        {
                            "wait": 1200
                        },
                        {
                            "role": "Auto-roll",
                            "optional": true
                        },
                        {
                            "wait": 1500
                        },
                        {
                            "eval": "document.querySelectorAll(\"[data-hud-block='hero'] button[aria-expanded='false'], [data-hud-block='dock'] button[aria-expanded='false']\").forEach(b=>b.click())"
                        },
                        {
                            "wait": 1200
                        }
                    ],
                    "restore": true
                },
                {
                    "name": "scenario",
                    "path": "/dm/scenario/{scenePageId}"
                },
                {
                    "name": "show",
                    "path": "/dm/show/{deckId}",
                    "steps": [
                        {
                            "role": {
                                "en": "Start show",
                                "uk": "Почати показ"
                            }
                        },
                        {
                            "wait": 2500
                        },
                        {
                            "goto": "/show"
                        },
                        {
                            "wait": 2000
                        }
                    ]
                },
                {
                    "name": "world",
                    "path": "/world",
                    "steps": [
                        {
                            "role": "Play"
                        },
                        {
                            "wait": 1500
                        },
                        {
                            "click": "[role=combobox]:has-text('DM view')"
                        },
                        {
                            "wait": 800
                        },
                        {
                            "click": "[role=option]:has-text('Lark')"
                        },
                        {
                            "wait": 2500
                        }
                    ]
                },
                {
                    "name": "constructor",
                    "path": "/dm/classes",
                    "steps": [
                        {
                            "link": "{classLink}"
                        },
                        {
                            "wait": 1500
                        }
                    ],
                    "zoom": 1.25
                },
                {
                    "name": "player-mobile",
                    "path": "/battles/{battleId}",
                    "mobile": true
                },
                {
                    "name": "dashboard",
                    "path": ""
                },
                {
                    "name": "soundboard",
                    "path": "/library/sounds",
                    "absolute": true
                },
                {
                    "name": "sheet",
                    "path": "/dm/characters/{sheetId}"
                },
                {
                    "name": "scenario-graph",
                    "path": "/dm/graph",
                    "steps": [
                        {
                            "text": "Show all entities",
                            "exact": true
                        },
                        {
                            "wait": 1500
                        },
                        {
                            "text": "Show single-link entities",
                            "exact": true
                        },
                        {
                            "wait": 2000
                        }
                    ]
                },
                {
                    "name": "content-copy",
                    "path": "/dm/maps",
                    "steps": [
                        {
                            "role": {
                                "en": "Copy to campaigns…",
                                "uk": "Копіювати в кампанії…"
                            }
                        },
                        {
                            "wait": 900
                        },
                        {
                            "click": "[role=dialog] label:has-text('Crypt of the Silent Bell')"
                        },
                        {
                            "wait": 300
                        },
                        {
                            "click": "[role=dialog] label:has-text('Ashen Vale Chronicle')"
                        },
                        {
                            "wait": 300
                        },
                        {
                            "click": "[role=dialog] label:has-text('Sunken Crown')"
                        },
                        {
                            "wait": 300
                        }
                    ],
                    "zoom": 1.6
                },
                {
                    "name": "mcp",
                    "path": "/dm/ai",
                    "zoom": 1.4,
                    "steps": [
                        {
                            "eval": "const w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let n;while((n=w.nextNode())) n.textContent=n.textContent.replaceAll('http://localhost:3000','https://critnest.com');"
                        },
                        {
                            "wait": 300
                        }
                    ]
                }
            ]
        },
