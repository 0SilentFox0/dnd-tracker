# Скопіюй у .env.local і заповни. Для Vercel — ті самі ключі в Dashboard → Environment Variables.

# Prisma / PostgreSQL. Для dev: pnpm db:local і
# DATABASE_URL=DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Прод (Supabase, регіон eu-central-1):
# Додаток: Transaction pooler 6543
DATABASE_URL="postgresql://postgres.[REF]:[PWD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Міграції (prisma migrate deploy): Session pooler або Direct, порт 5432
DIRECT_URL="postgresql://postgres.[REF]:[PWD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Prisma pool size per instance (default: 5 on Vercel, 10 in dev)
# PRISMA_CONNECTION_LIMIT=5
# CAPACITY_PROFILE=free            # free|paid, see lib/config/capacity.ts; any field via CAP_<NAME>
# NEXT_PUBLIC_CAPACITY_PROFILE=free

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# Optional: Cloudflare cache host in front of Supabase Storage (infra/media-worker); unset = direct URLs
# NEXT_PUBLIC_MEDIA_BASE_URL="https://critnest-media.critnest.workers.dev"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Pusher (опційно; без них бій працює без live-оновлень)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
# Pusher app має бути створений у кластері eu; за замовчуванням у коді теж eu
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
# Self-hosted Pusher-protocol server (Soketi); leave unset for hosted Pusher
# PUSHER_HOST=
# PUSHER_PORT=
# PUSHER_USE_TLS=true
# NEXT_PUBLIC_PUSHER_WS_HOST=
# NEXT_PUBLIC_PUSHER_WS_PORT=
# NEXT_PUBLIC_PUSHER_FORCE_TLS=true

# Опційно: Redis-кеш для довідкових запитів (lib/cache/kv.ts)
# Можна підключити через Vercel Marketplace (Redis Cloud) або власний redis.
# REDIS_URL="redis://default:password@host:port"

# Опційно: Upstash Redis (REST API) — для rate limiting на battle endpoints
# (lib/utils/api/rate-limit.ts) і потенційно cache. Ідеально для Vercel
# serverless (HTTP без persistent TCP). Free tier 10k requests/day.
# Знайти у Upstash console → Database → REST API → Endpoint URL + Token.
# UPSTASH_REDIS_REST_URL="https://xxx-xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""
# Прод без Upstash: чутливі роути дають 503; тимчасово дозволити пам'ять інстансу
# RATE_LIMIT_ALLOW_MEMORY=1
# За власним проксі (не Vercel): довіряти x-forwarded-for / x-real-ip, інакше всі клієнти в одному відрі
# TRUST_PROXY=1

# Дев: логи таймінгу ходів
# NEXT_PUBLIC_BATTLE_TURN_TIMING=1
# BATTLE_TURN_TIMING=1

# AI-асистент: ключ шифрування ключів провайдерів (openssl rand -base64 32)
AI_KEYS_SECRET=
AI_KEYS_SECRET_PREV=

# Імпорт JSON-компендіуму: підпис preview/confirm, ≥ 32 символи (openssl rand -base64 32); без нього імпорт повертає 503.
COMPENDIUM_PREVIEW_SECRET=

# /api/health?deep=1 (перевірка БД): заголовок x-health-secret або Bearer; без значення deep повертає 401.
HEALTH_SECRET=

# Ops (docs/architecture/ops.md). Усе необов'язкове: без змінної відповідна частина вимкнена.
# Колектор POST /api/ops/collect: Bearer-токен, openssl rand -base64 32; без нього колектор повертає 503. Те саме значення в секретах воркера.
# Email-и (через кому), яким доступний /ops і посилання в профілі; додатково до PLATFORM_ADMIN_USER_IDS.
OPS_ADMIN_EMAILS=
OPS_COLLECT_SECRET=
# Telegram-сповіщення (бот і чат); також секрети воркера infra/ops-watchdog.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
# Email-сповіщення через Resend: адресат і відправник (верифікований домен).
RESEND_API_KEY=
OPS_ALERT_EMAIL=
OPS_ALERT_FROM=
# Адаптер Cloudflare: токен з правом Analytics read, id акаунта, ім'я воркера.
OPS_CLOUDFLARE_API_TOKEN=
OPS_CLOUDFLARE_ACCOUNT_ID=
OPS_CLOUDFLARE_WORKER_NAME=
# Скільки одержувачів у середньому на один Pusher trigger (оцінка повідомлень за день); за замовчуванням 6.
OPS_PUSHER_FANOUT=
# paid вмикає ліміти платного тарифу провайдера (за замовчуванням free).
OPS_TIER_SUPABASE=
OPS_TIER_VERCEL=
OPS_TIER_PUSHER=
OPS_TIER_UPSTASH=
OPS_TIER_CLOUDFLARE=
