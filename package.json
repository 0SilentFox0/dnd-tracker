{
  "name": "dnd-combat-tracker",
  "version": "0.1.0",
  "private": true,
  "sideEffects": ["*.css"],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:local": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "postinstall": "node scripts/postinstall.mjs",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "deploy:dev": "vercel --dev",
    "sync-env:vercel": "node scripts/sync-env-to-vercel.mjs",
    "migrate-spell-icons-to-supabase": "tsx scripts/migrate-spell-icons-to-supabase.ts",
    "redistribute-character-spell-slots": "tsx scripts/redistribute-character-spell-slots.ts",
    "migrate-unit-icons-to-supabase": "tsx scripts/migrate-unit-icons-to-supabase.ts",
    "upload-assets-to-supabase": "tsx scripts/upload-assets-to-supabase.ts",
    "import-units": "tsx scripts/import-units.ts",
    "seed-artifacts": "tsx scripts/seed-artifacts.ts",
    "import-skills-library": "tsx scripts/import-skills-library.ts",
    "import-artifact-icons": "tsx scripts/import-artifact-icons.ts",
    "import-wiki-icons": "tsx scripts/import-wiki-icon-bundle.ts",
    "seed-library": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/seed-library.ts",
    "balance-library": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/balance-library.ts",
    "simulate-battle": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json scripts/simulate-battle.ts",
    "seed-mock-battle": "tsx scripts/seed-mock-battle-data.ts",
    "delete-mock-battle": "tsx scripts/delete-mock-battle-data.ts",
    "reset-mock-battle": "tsx scripts/reset-mock-battle-data.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "migrate:deploy": "bash scripts/prisma-migrate-deploy.sh",
    "db:local": "docker compose up -d --wait db && pnpm migrate:deploy"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.17",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "prisma": "^6",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "happy-dom": "^20.5.0",
    "jsdom": "^28.0.0",
    "knip": "^5.88.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.15.5+sha512.845196026aab1cc3f098a0474b64dfbab2afe7a1b4e91dd86895d8e4aa32a7a6d03049e2d0ad770bbe4de023a7122fb68c1a1d6e0d033c7076085f9d5d4800d4",
  "pnpm": {
    "overrides": {
      "@radix-ui/react-context": "1.1.3",
      "@radix-ui/react-primitive": "2.1.4",
      "@radix-ui/react-slot": "1.2.4"
    }
  }
}
