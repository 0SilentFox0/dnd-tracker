{
  "entry": [
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.ts"
  ],
  "project": [
    "**/*.{ts,tsx,mjs,mts}"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "server-only"
  ],
  "ignoreBinaries": [
    "vercel"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "classMembers": "off",
    "duplicates": "off"
  },
  "ignore": [
    ".claude/**"
  ]
}
