{
  "entry": [
    "scripts/**/*.{ts,tsx,mjs,mts}",
    "systems/*/index.ts",
    "lib/i18n/request.ts"
  ],
  "project": [
    "**/*.{ts,tsx,mjs,mts}"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "server-only"
  ],
  "ignoreBinaries": [
    "vercel"
  ],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "classMembers": "off",
    "duplicates": "off"
  }
}
